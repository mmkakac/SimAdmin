config main 'main'
	option enabled '1'
	option port '3000'
	option host '0.0.0.0'
	# 蜂窝数据所在 netifd 接口（VoLTE 启用时上游会临时接管该接口的 profile）
	option wwan_iface 'wwan'
	# 数据目录（config.json / data.db）
	option data_dir '/opt/simadmin'
	option install_dir '/opt/simadmin'
	# 日志级别（对应 RUST_LOG）。默认 info。
	# 想减少 logread 刷屏（例如屏蔽短信轮询心跳）可写成：
	#   option rust_log 'info,simadmin::sms_listener=warn'
	# 只保留警告以上：option rust_log 'warn'
	option rust_log 'info'
	# modem 看护：连续两次发现 modem 处于 disabled 就补一次 enable，
	# 避免「开机后一直无网络、要手动关一次飞行模式」。暂停：touch /etc/simadmin.modem-watchdog.off
	option modem_watchdog '1'
	option modem_watchdog_interval '30'
