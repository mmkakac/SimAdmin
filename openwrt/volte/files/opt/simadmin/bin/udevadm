#!/bin/sh
# udevadm 兼容层（OpenWrt / procd + mdev）
#
# 上游 VoLTE 版在准备 IMS 运行时会执行 `udevadm control --reload-rules`
# 与 `udevadm trigger`（为 secondary-qmi 设备节点建规则）。OpenWrt 没有 udev，
# 用 procd/hotplug 机制，这里对所有子命令做「成功但无副作用」的响应。

case "$1" in
	--version)
		echo "udevadm (simadmin-shim)"
		exit 0
		;;
	info)
		# 无 udev 数据库，返回空
		exit 0
		;;
	control|trigger|settle|monitor|test|wait)
		exit 0
		;;
	*)
		exit 0
		;;
esac
