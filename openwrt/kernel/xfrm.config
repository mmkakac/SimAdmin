# SimAdmin VoLTE on OpenWrt —— 内核侧必需选项（XFRM / IPsec）
#
# 背景：
#   中国移动/联通/电信的 IMS（VoLTE）在 SIP REGISTER 阶段强制要求 IPsec
#   安全协商（P-CSCF 会返回 `Security-Server: ipsec-3gpp;alg=hmac-md5-96;prot=esp`）。
#   VoLTE 引擎（上游 simadmin volte 版）用 `ip xfrm` 安装 SA/策略；
#   若内核没有 XFRM 支持，会报：
#       Cannot open netlink socket: Protocol not supported
#   然后退回明文 UDP，网络回 420 Bad Extension，注册必然失败。
#
# 适用：msm89xx/msm8916（UF896 类）等裁剪内核，config-<ver> 里 XFRM 全被关掉的情况。
#
# 用法（源码树根目录）：
#   cat openwrt/kernel/xfrm.config >> target/linux/msm89xx/config-6.18
#   make -j"$(nproc)"
#   （版本号按实际，如 config-5.10 / config-6.12 / config-6.18；target 目录按你的板子）
#
# 验证（刷机后）：
#   zcat /proc/config.gz | grep -E "XFRM_USER|INET_ESP"
#   ip xfrm state          # 不再报 Protocol not supported 即为成功
#
# 体积影响：约 150~200KB（内核内置，不需要额外 kmod 包）

CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_ALGO=y
CONFIG_XFRM_STATISTICS=y
CONFIG_XFRM_MIGRATE=y

# IPv4 / IPv6 的 ESP、AH（3GPP IPsec 只用 ESP，AH 一并打开成本极低）
CONFIG_INET_ESP=y
CONFIG_INET_AH=y
CONFIG_INET6_ESP=y
CONFIG_INET6_AH=y
CONFIG_INET6_ESP_OFFLOAD=n

# 3GPP IPsec 的典型算法组合：
#   ealg=null  → ecb(cipher_null)
#   alg=hmac-md5-96 / hmac-sha1-96 → hmac(md5) / hmac(sha1)
#   部分运营商还会协商 aes-cbc / aes-ctr
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_NULL2=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_AEAD2=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_AES=y

# 统计节点（/proc/net/xfrm_stat），排障用，可省
CONFIG_XFRM_SUB_POLICY=y
